#!/usr/bin/env bash
# Interactive shell configuration (Linux)

# Homebrew update policy is managed in ~/.homebrew/brew.env (ADR 0026).

export ASDF_CONFIG_FILE="$HOME/.config/asdf/.asdfrc"

# Linuxbrew shellenv
if [[ -e /home/linuxbrew/.linuxbrew/bin/brew ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# Version manager shims: mise once it is on PATH, `mise install` has created its
# shims directory, and ~/.tool-versions has been retired (ADR 0041,
# docs/mise.md); otherwise asdf until this machine is migrated.
# PATH order: shims are prepended here, but later `~/.local/bin` / `~/.cargo/bin`
# / `~/.bun/bin` prepends push them back. Final PATH = native installers > shims.
# This is intentional (native installers win for overlapping tools; shims act as
# an overlay — see ADR 0023). To use the pinned version of an overlapping tool,
# run `mise exec <tool> -- ...` (or `asdf exec <tool>` before migration).
_mise_shims="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims"
_asdf_shims="${ASDF_DATA_DIR:-$HOME/.asdf}/shims"
_path_drop() {
    local p=":$PATH:"
    while [[ "$p" == *":$1:"* ]]; do p="${p//":$1:"/:}"; done
    p="${p#:}"
    PATH="${p%:}"
}
_path_prepend_once() {
    [[ ":$PATH:" == *":$1:"* ]] || PATH="$1:$PATH"
}
if command -v mise &>/dev/null && [[ -d "$_mise_shims" && ! -e "$HOME/.tool-versions" ]]; then
    # A parent shell may have exported the other manager's shims.
    _path_drop "$_asdf_shims"
    _path_prepend_once "$_mise_shims"
    export PATH
    # Shims do not export JAVA_HOME. Recompute it before each prompt (interactive
    # shells only) to follow the directory's Java version, overriding any
    # existing value like the former asdf-java hook did.
    _mise_update_java_home() {
        local java_path full_path=""
        java_path="$(mise which java 2>/dev/null)" || java_path=""
        [[ -n "$java_path" ]] && full_path="$(realpath "$java_path" 2>/dev/null)"
        if [[ -z "$full_path" ]]; then
            # Do not leave the previous directory's JDK behind. Clear only the
            # values this hook exported, so a user-set JAVA_HOME survives.
            if [[ -n "${_MISE_JAVA_HOME:-}" && "${JAVA_HOME:-}" == "$_MISE_JAVA_HOME" ]]; then
                unset JAVA_HOME JDK_HOME
            fi
            unset _MISE_JAVA_HOME
            return 0
        fi
        JAVA_HOME="$(dirname "$(dirname "$full_path")")"
        export JAVA_HOME JDK_HOME="$JAVA_HOME"
        _MISE_JAVA_HOME="$JAVA_HOME"
    }
    PROMPT_COMMAND="_mise_update_java_home${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
else
    _path_drop "$_mise_shims"
    export PATH
    if command -v asdf &>/dev/null; then
        _path_prepend_once "$_asdf_shims"
        . <(asdf completion bash)
        # asdf-java JAVA_HOME hook (parity with fish set-java-home.fish)
        [[ -f "$HOME/.asdf/plugins/java/set-java-home.bash" ]] \
            && . "$HOME/.asdf/plugins/java/set-java-home.bash"
    fi
fi
unset -f _path_drop _path_prepend_once
unset _mise_shims _asdf_shims

# Local bin (uv installer puts uv here)
[[ -d "$HOME/.local/bin" ]] && PATH="$HOME/.local/bin:$PATH"

# Rust (rustup)
[[ -d "$HOME/.cargo/bin" ]] && PATH="$HOME/.cargo/bin:$PATH"

# Bun
export BUN_INSTALL="$HOME/.bun"
[[ -d "$BUN_INSTALL/bin" ]] && PATH="$BUN_INSTALL/bin:$PATH"

# OCaml(opam)
if [[ -r "$HOME/.opam/opam-init/init.sh" ]]; then
    source "$HOME/.opam/opam-init/init.sh" >/dev/null 2>&1 || true
fi

# Starship prompt
command -v starship &>/dev/null && eval "$(starship init bash)"

# direnv
command -v direnv &>/dev/null && eval "$(direnv hook bash)"

# fzf key bindings (Ctrl-R, Ctrl-T, Alt-C) + completion
if [[ -n "$HOMEBREW_PREFIX" && -f "$HOMEBREW_PREFIX/opt/fzf/shell/key-bindings.bash" ]]; then
    source "$HOMEBREW_PREFIX/opt/fzf/shell/key-bindings.bash"
fi
if [[ -n "$HOMEBREW_PREFIX" && -f "$HOMEBREW_PREFIX/opt/fzf/shell/completion.bash" ]]; then
    source "$HOMEBREW_PREFIX/opt/fzf/shell/completion.bash"
fi

# Aliases (translated from fish abbr/function)
alias be='bundle exec'
alias bru='brew-reviewed-upgrade'
alias brcu='brew-reviewed-cask-upgrade'
alias cm='chezmoi'
alias d='docker'
alias dc='docker compose'
alias gd='git diff-delta'
alias gst='git status'
alias l='eza -ahl --git'
alias ll='ls -ahl'
alias tree='eza -T'

# SSH agent: always prefer the systemd user ssh-agent socket when it exists.
# This box is GitHub-only with no agent forwarding (ADR 0027), so we deliberately ignore any inherited
# SSH_AUTH_SOCK — a stray forwarded or broader-scoped agent is never used here, and a stale inherited
# value cannot silently block git. No-op (keeps the inherited value) on machines without the service.
_ssh_agent_sock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/ssh-agent.socket"
if [[ -S "$_ssh_agent_sock" ]]; then
    export SSH_AUTH_SOCK="$_ssh_agent_sock"
fi
unset _ssh_agent_sock

# Managed Bash scripts use Homebrew Bash; this does not change the login shell.
if [[ -n "${HOMEBREW_PREFIX:-}" && -x "$HOMEBREW_PREFIX/opt/bash/bin/bash" ]]; then
    export PATH="$HOMEBREW_PREFIX/opt/bash/bin:$PATH"
fi

# Machine-specific overrides
[[ -f "$HOME/.bashrc.local" ]] && source "$HOME/.bashrc.local"
