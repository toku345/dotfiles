#!/usr/bin/env bash
# shellcheck shell=bash
# Upgrade one reviewed homebrew/cask Cask without weakening local policy.

set -Eeuo pipefail

if (( BASH_VERSINFO[0] < 5 )); then
  printf 'brew-reviewed-cask-upgrade: bash %d.%d is too old; this script requires bash 5+.\n' \
    "${BASH_VERSINFO[0]}" "${BASH_VERSINFO[1]}" >&2
  printf 'On macOS: run `brew install bash` and ensure Homebrew bash precedes /bin/bash on PATH.\n' >&2
  exit 2
fi

readonly PROGRAM_NAME="brew-reviewed-cask-upgrade"
readonly POLICY_FILE_RELATIVE=".homebrew/brew.env"
readonly GITHUB_API_VERSION="2026-03-10"
readonly COOLDOWN_SECONDS=604800

BREW_BIN=""
GH_BIN=""
JQ_BIN=""
TEMP_DIR=""
ACTIVE_PID=""
MANAGED_LAUNCHING=0
PENDING_SIGNAL_NAME=""
PENDING_SIGNAL_STATUS=0
INSTALLED_VERSION=""
CANDIDATE_VERSION=""
CANDIDATE_SHA256=""
CANDIDATE_URL=""
CANDIDATE_HOMEPAGE=""
OUTDATED_INSTALLED=""
OUTDATED_CANDIDATE=""
RELEASE_OWNER=""
RELEASE_REPO=""
RELEASE_TAG=""
RELEASE_SOURCE_KIND=""
RELEASE_ASSET_NAME=""
RELEASE_NOTES_URL=""
RELEASE_RECORD_PUBLISHED_AT=""
RELEASE_PUBLISHED_AT=""
RELEASE_ASSET_CREATED_AT=""
RELEASE_ASSET_UPDATED_AT=""
RELEASE_ELIGIBLE_AT=""
RELEASE_AGE_SECONDS=0
RELEASE_AGE_VERIFIED=0
RELEASE_GATE_STATUS=""
RELEASE_GATE_REASON=""
RELEASE_DRAFT=""
RELEASE_PRERELEASE=""

usage() {
  cat <<'EOF'
Usage:
  brew-reviewed-cask-upgrade [--cooldown-exception REASON] CASK -- COMMAND [ARG...]

Upgrade exactly one installed, unpinned homebrew/cask Cask after reviewing its
release age, checksum-backed metadata, bounded artifact set, and dry-run plan.

A smoke command is always required. Releases newer than 7 days or without
verifiable GitHub Release metadata stop unless --cooldown-exception supplies a
non-secret, single-line reason.
EOF
}

error() {
  printf '%s: %s\n' "$PROGRAM_NAME" "$1" >&2
}

status_printf() {
  local label="$1"
  shift

  if ! printf "$@"; then
    error "could not display $label"
    return 1
  fi
}

resolve_command() {
  local name="$1"
  local resolved

  if ! resolved="$(type -P "$name")" || [[ -z "$resolved" ]]; then
    error "required command not found on PATH: $name"
    return 127
  fi
  printf '%s\n' "$resolved"
}

capture_command() {
  local output_file="$1"
  shift

  if "$@" >"$output_file"; then
    return 0
  else
    return $?
  fi
}

publish_managed_pid() {
  ACTIVE_PID="$1"
  MANAGED_LAUNCHING=0

  if [[ -n "$PENDING_SIGNAL_NAME" ]]; then
    local signal_name="$PENDING_SIGNAL_NAME"
    local signal_status="$PENDING_SIGNAL_STATUS"
    PENDING_SIGNAL_NAME=""
    PENDING_SIGNAL_STATUS=0
    handle_signal "$signal_name" "$signal_status"
  fi
}

run_managed() {
  PENDING_SIGNAL_NAME=""
  PENDING_SIGNAL_STATUS=0
  MANAGED_LAUNCHING=1
  "$@" <&0 &
  publish_managed_pid "$!"

  local status
  if wait "$ACTIVE_PID"; then
    status=0
  else
    status=$?
  fi
  ACTIVE_PID=""
  return "$status"
}

handle_signal() {
  local signal_name="$1"
  local status="$2"
  local child_status=0

  if (( MANAGED_LAUNCHING )); then
    if [[ -z "$PENDING_SIGNAL_NAME" ]]; then
      PENDING_SIGNAL_NAME="$signal_name"
      PENDING_SIGNAL_STATUS="$status"
    fi
    return 0
  fi

  trap '' INT TERM
  if [[ -n "$ACTIVE_PID" ]]; then
    if ! kill -s TERM "$ACTIVE_PID" 2>/dev/null \
      && kill -0 "$ACTIVE_PID" 2>/dev/null; then
      error "could not stop managed process $ACTIVE_PID after $signal_name"
    fi
    if wait "$ACTIVE_PID" 2>/dev/null; then
      child_status=0
    else
      child_status=$?
    fi
    if (( child_status == 127 )); then
      error "could not reap managed process $ACTIVE_PID after $signal_name"
    fi
    ACTIVE_PID=""
  fi
  exit "$status"
}

cleanup_on_exit() {
  local operation_status=$?
  local cleanup_status=0

  trap - EXIT
  trap '' INT TERM
  set +e
  if [[ -n "$TEMP_DIR" && -d "$TEMP_DIR" ]]; then
    rm -rf -- "$TEMP_DIR"
    cleanup_status=$?
  fi

  if (( operation_status != 0 && cleanup_status != 0 )); then
    error "operation failed with status $operation_status; temporary-file cleanup also failed with status $cleanup_status"
  elif (( cleanup_status != 0 )); then
    error "temporary-file cleanup failed with status $cleanup_status"
  fi
  if (( operation_status != 0 )); then
    exit "$operation_status"
  fi
  if (( cleanup_status != 0 )); then
    exit 1
  fi
  exit 0
}

install_lifecycle_traps() {
  trap cleanup_on_exit EXIT
  trap 'handle_signal INT 130' INT
  trap 'handle_signal TERM 143' TERM
}

validate_policy_file() {
  local policy_file="$HOME/$POLICY_FILE_RELATIVE"
  local assignment expected name value count values_file forbidden_file

  if [[ ! -r "$policy_file" ]]; then
    error "managed Homebrew policy is missing or unreadable: $policy_file"
    return 1
  fi

  for assignment in \
    'HOMEBREW_NO_AUTO_UPDATE=1' \
    'HOMEBREW_NO_INSTALL_UPGRADE=1' \
    'HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK=1' \
    'HOMEBREW_CASK_OPTS=--require-sha' \
    'HOMEBREW_UPDATE_TO_TAG=1' \
    'HOMEBREW_VERIFY_ATTESTATIONS=1'
  do
    name="${assignment%%=*}"
    expected="${assignment#*=}"
    count=0
    value=""
    values_file="$TEMP_DIR/policy-values-$name"
    if ! awk -F= -v key="$name" \
      '$1 == key { sub(/^[^=]*=/, ""); print }' \
      "$policy_file" >"$values_file"; then
      error "could not parse managed Homebrew policy: $policy_file"
      return 1
    fi
    while IFS= read -r value; do
      count=$((count + 1))
      if [[ "$value" != "$expected" ]]; then
        error "$policy_file must set $name=$expected exactly once"
        return 1
      fi
    done <"$values_file"
    if (( count != 1 )); then
      error "$policy_file must set $name=$expected exactly once"
      return 1
    fi
  done

  forbidden_file="$TEMP_DIR/policy-forbidden"
  if ! awk -F= \
    '$1 == "HOMEBREW_NO_VERIFY_ATTESTATIONS" || $1 == "HOMEBREW_NO_ASK" { print }' \
    "$policy_file" >"$forbidden_file"; then
    error "could not scan managed Homebrew policy: $policy_file"
    return 1
  fi
  if [[ -s "$forbidden_file" ]]; then
    error "$policy_file must not disable attestations or Homebrew ask mode"
    return 1
  fi
}

validate_effective_policy() {
  local config_file="$TEMP_DIR/brew-config"
  local required grep_status

  if ! capture_command "$config_file" "$BREW_BIN" config; then
    error "brew config failed"
    return 1
  fi
  for required in \
    'HOMEBREW_NO_AUTO_UPDATE: set' \
    'HOMEBREW_NO_INSTALL_UPGRADE: set' \
    'HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK: set' \
    'HOMEBREW_UPDATE_TO_TAG: set' \
    'HOMEBREW_VERIFY_ATTESTATIONS: set'
  do
    if ! grep -Fqx "$required" "$config_file"; then
      error "effective Homebrew policy is missing: $required"
      return 1
    fi
  done
  if ! grep -Fqx 'HOMEBREW_CASK_OPTS: ["--require-sha"]' "$config_file"; then
    error "effective Homebrew policy must set HOMEBREW_CASK_OPTS to --require-sha"
    return 1
  fi
  if grep -Eq '^HOMEBREW_(NO_VERIFY_ATTESTATIONS|NO_ASK): set$' "$config_file"; then
    error "effective environment disables attestations or Homebrew ask mode"
    return 1
  else
    grep_status=$?
    if (( grep_status != 1 )); then
      error "could not inspect effective Homebrew policy"
      return 1
    fi
  fi
}

validate_developer_mode() {
  local state_file="$TEMP_DIR/developer-state-preflight"

  if ! capture_command "$state_file" "$BREW_BIN" developer state; then
    error "could not determine Homebrew developer mode"
    return 1
  fi
  if ! grep -Fqx 'Developer mode is disabled.' "$state_file"; then
    cat "$state_file" >&2
    error "Homebrew developer mode must be disabled; follow docs/homebrew-update.md recovery steps"
    return 1
  fi
}

validate_metadata_shape() {
  local metadata_file="$1"
  local label="$2"

  if ! "$JQ_BIN" -e '
    def allowed_artifact_keys:
      ["app", "binary", "bash_completion", "fish_completion",
       "zsh_completion", "manpage", "generate_completions_from_executable",
       "zap", "target"];
    def allowed_dependency_keys:
      ["macos", "maximum_macos", "linux", "arch"];
    (.formulae | type) == "array" and (.formulae | length) == 0
      and (.casks | type) == "array" and (.casks | length) == 1
      and (.casks[0] | type) == "object"
      and (.casks[0].token | type) == "string" and (.casks[0].token | length) > 0
      and (.casks[0].token | test("[[:cntrl:][:space:]]") | not)
      and .casks[0].tap == "homebrew/cask"
      and (.casks[0].installed | type) == "string" and (.casks[0].installed | length) > 0
      and .casks[0].pinned == false
      and .casks[0].deprecated == false
      and .casks[0].disabled == false
      and (.casks[0].auto_updates == null or .casks[0].auto_updates == false)
      and (.casks[0].version | type) == "string"
      and (.casks[0].version | length) > 0 and .casks[0].version != "latest"
      and (.casks[0].version | test("[[:cntrl:]]") | not)
      and (.casks[0].sha256 | type) == "string"
      and (.casks[0].sha256 | test("^[[:xdigit:]]{64}$"))
      and (.casks[0].url | type) == "string" and (.casks[0].url | length) > 0
      and (.casks[0].url | test("[[:cntrl:]]") | not)
      and ((.casks[0].homepage // "") | type) == "string"
      and ((.casks[0].homepage // "") | test("[[:cntrl:]]") | not)
      and (.casks[0].artifacts | type) == "array"
      and (.casks[0].artifacts | length) > 0
      and any(.casks[0].artifacts[]; has("app") or has("binary"))
      and all(.casks[0].artifacts[];
        type == "object" and length > 0
          and ((keys - allowed_artifact_keys) | length) == 0
          and ([keys[] | select(. != "target")] | length) > 0)
      and ((.casks[0].depends_on // {}) | type) == "object"
      and ((((.casks[0].depends_on // {}) | keys) - allowed_dependency_keys) | length) == 0
      and ((.casks[0].conflicts_with // null) == null
        or (.casks[0].conflicts_with == {})
        or (.casks[0].conflicts_with == []))
  ' "$metadata_file" >/dev/null; then
    error "$label Cask metadata is malformed or outside the strict supported scope"
    return 1
  fi
}

load_named_metadata() {
  local requested="$1"
  local output_file="$2"
  local label="$3"

  if ! capture_command "$output_file" "$BREW_BIN" info --cask --json=v2 "$requested"; then
    error "Cask not found or is not a Cask: $requested"
    return 1
  fi
  validate_metadata_shape "$output_file" "$label"
}

validate_installed_state_shape() {
  local metadata_file="$1"

  if ! "$JQ_BIN" -e '
    (.formulae | type) == "array" and (.formulae | length) == 0
      and (.casks | type) == "array" and (.casks | length) == 1
      and (.casks[0] | type) == "object"
      and (.casks[0].token | type) == "string" and (.casks[0].token | length) > 0
      and (.casks[0].token | test("[[:cntrl:][:space:]]") | not)
      and .casks[0].tap == "homebrew/cask"
      and (.casks[0].installed | type) == "string" and (.casks[0].installed | length) > 0
      and .casks[0].pinned == false
  ' "$metadata_file" >/dev/null; then
    error "installed Cask state is malformed or outside the strict supported scope"
    return 1
  fi
}

load_installed_state() {
  local canonical="$1"
  local output_file="$2"
  local inventory_file="$TEMP_DIR/info-installed-inventory.json"

  if ! capture_command "$inventory_file" "$BREW_BIN" info --cask --json=v2 --installed; then
    error "could not load installed Cask metadata"
    return 1
  fi
  if ! "$JQ_BIN" -e --arg token "$canonical" '
    (.formulae | type) == "array" and (.casks | type) == "array"
      and ([.casks[] | select(.token == $token)] | length) == 1
  ' "$inventory_file" >/dev/null; then
    error "installed Cask metadata is missing or ambiguous: $canonical"
    return 1
  fi
  if ! "$JQ_BIN" -e --arg token "$canonical" \
    '{formulae: [], casks: [.casks[] | select(.token == $token)]}' \
    "$inventory_file" >"$output_file"; then
    error "could not isolate installed Cask metadata: $canonical"
    return 1
  fi
  validate_installed_state_shape "$output_file"
}

metadata_value() {
  local metadata_file="$1"
  local filter="$2"
  "$JQ_BIN" -er "$filter" "$metadata_file"
}

write_installed_state_snapshot() {
  local metadata_file="$1"
  local snapshot_file="$2"

  if ! "$JQ_BIN" -S -c \
    '.casks[0] | {token, tap, installed, pinned}' \
    "$metadata_file" >"$snapshot_file"; then
    error "could not encode installed Cask state"
    return 1
  fi
}

load_installed_receipt_snapshot() {
  local canonical="$1"
  local installed_version="$2"
  local snapshot_file="$3"
  local caskroom_file="$TEMP_DIR/caskroom-path"
  local caskroom receipt_path
  local -a caskroom_lines=()

  if ! capture_command "$caskroom_file" "$BREW_BIN" --caskroom "$canonical"; then
    error "could not resolve the installed Caskroom path: $canonical"
    return 1
  fi
  if ! mapfile -t caskroom_lines <"$caskroom_file"; then
    error "could not read the installed Caskroom path: $canonical"
    return 1
  fi
  if (( ${#caskroom_lines[@]} != 1 )); then
    error "installed Caskroom path is missing or ambiguous: $canonical"
    return 1
  fi
  caskroom="${caskroom_lines[0]}"
  if [[ "$caskroom" != /* || "$caskroom" =~ [[:cntrl:]] || ! -d "$caskroom" ]]; then
    error "installed Caskroom path is invalid: $canonical"
    return 1
  fi

  receipt_path="$caskroom/.metadata/INSTALL_RECEIPT.json"
  if [[ ! -f "$receipt_path" || -L "$receipt_path" ]]; then
    error "installed Cask INSTALL_RECEIPT.json is missing or not a regular file: $canonical"
    return 1
  fi

  if ! "$JQ_BIN" -e --arg version "$installed_version" '
    def allowed_artifact_keys:
      ["app", "binary", "bash_completion", "fish_completion",
       "zsh_completion", "manpage", "generate_completions_from_executable",
       "zap", "target"];
    type == "object"
      and (.source | type) == "object"
      and .source.tap == "homebrew/cask"
      and .source.version == $version
      and .installed_on_request == true
      and (.runtime_dependencies == {} or .runtime_dependencies == [])
      and .uninstall_flight_blocks == false
      and (.uninstall_artifacts | type) == "array"
      and (.uninstall_artifacts | length) > 0
      and any(.uninstall_artifacts[]; has("app") or has("binary"))
      and all(.uninstall_artifacts[];
        type == "object" and length > 0
          and ((keys - allowed_artifact_keys) | length) == 0
          and ([keys[] | select(. != "target")] | length) > 0)
  ' "$receipt_path" >/dev/null; then
    error "installed Cask receipt is malformed or outside the strict supported scope"
    return 1
  fi
  if ! "$JQ_BIN" -S -c '
    {source: {tap: .source.tap, tap_git_head: .source.tap_git_head,
              version: .source.version},
     installed_on_request, runtime_dependencies, uninstall_artifacts,
     uninstall_flight_blocks}
  ' "$receipt_path" >"$snapshot_file"; then
    error "could not encode installed Cask receipt metadata"
    return 1
  fi
}

write_candidate_snapshot() {
  local metadata_file="$1"
  local snapshot_file="$2"

  if ! "$JQ_BIN" -S -c '
    .casks[0]
      | {token, tap, version, sha256, pinned, deprecated, disabled,
         auto_updates, url, homepage, artifacts, depends_on, conflicts_with}
  ' "$metadata_file" >"$snapshot_file"; then
    error "could not encode candidate Cask safety metadata"
    return 1
  fi
}

decode_url_component() {
  local encoded="$1"
  local decoded=""
  local prefix hex byte

  if [[ -z "$encoded" || "$encoded" =~ [[:cntrl:]] ]]; then
    return 1
  fi
  while [[ "$encoded" == *%* ]]; do
    if [[ ! "$encoded" =~ ^([^%]*)%([[:xdigit:]]{2})(.*)$ ]]; then
      return 1
    fi
    prefix="${BASH_REMATCH[1]}"
    hex="${BASH_REMATCH[2]}"
    encoded="${BASH_REMATCH[3]}"
    if [[ "$hex" == "00" ]]; then
      return 1
    fi
    printf -v byte '%b' "\\x$hex"
    decoded+="$prefix$byte"
  done
  decoded+="$encoded"
  if [[ -z "$decoded" || "$decoded" =~ [[:cntrl:]] ]]; then
    return 1
  fi
  printf '%s\n' "$decoded"
}

extract_github_release_coordinates() {
  local info_file="$1"
  local encoded_tag="" encoded_asset=""

  RELEASE_OWNER=""
  RELEASE_REPO=""
  RELEASE_TAG=""
  RELEASE_SOURCE_KIND=""
  RELEASE_ASSET_NAME=""

  CANDIDATE_URL="$(metadata_value "$info_file" '.casks[0].url')" || {
    RELEASE_GATE_REASON="Cask download URL is missing or malformed"
    return 1
  }
  if [[ "$CANDIDATE_URL" =~ ^https://github\.com/([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+)/releases/download/([^/]+)/([^/?#]+)$ ]]; then
    RELEASE_OWNER="${BASH_REMATCH[1]}"
    RELEASE_REPO="${BASH_REMATCH[2]}"
    encoded_tag="${BASH_REMATCH[3]}"
    encoded_asset="${BASH_REMATCH[4]}"
    RELEASE_SOURCE_KIND="release-asset"
  elif [[ "$CANDIDATE_URL" =~ ^https://github\.com/([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+)/archive/refs/tags/(.+)\.(tar\.gz|zip)$ ]]; then
    RELEASE_OWNER="${BASH_REMATCH[1]}"
    RELEASE_REPO="${BASH_REMATCH[2]}"
    encoded_tag="${BASH_REMATCH[3]}"
    RELEASE_SOURCE_KIND="tag-archive"
  else
    RELEASE_GATE_REASON="Cask download is not a supported GitHub release URL"
    return 1
  fi
  RELEASE_TAG="$(decode_url_component "$encoded_tag")" || {
    RELEASE_GATE_REASON="GitHub release tag is malformed"
    return 1
  }
  if [[ "$RELEASE_SOURCE_KIND" == "release-asset" ]]; then
    RELEASE_ASSET_NAME="$(decode_url_component "$encoded_asset")" || {
      RELEASE_GATE_REASON="GitHub release asset name is malformed"
      return 1
    }
  fi
}

display_captured_diagnostics() {
  local diagnostic_file="$1"
  local label="$2"

  if [[ -s "$diagnostic_file" ]] && ! cat "$diagnostic_file" >&2; then
    error "could not display $label diagnostics"
    return 1
  fi
}

prepare_github_client() {
  local output_file="$TEMP_DIR/gh-auth-status"
  local status=0

  if ! GH_BIN="$(type -P gh)" || [[ -z "$GH_BIN" ]]; then
    RELEASE_GATE_REASON="GitHub CLI is unavailable"
    return 1
  fi
  if "$GH_BIN" auth status --hostname github.com >"$output_file" 2>&1; then
    return 0
  else
    status=$?
    display_captured_diagnostics "$output_file" "GitHub authentication" || true
    RELEASE_GATE_REASON="GitHub CLI authentication failed with status $status"
    return 1
  fi
}

lookup_github_release() {
  local output_file="$TEMP_DIR/github-release.json"
  local error_file="$TEMP_DIR/github-release-error"
  local encoded_tag asset_values status=0

  encoded_tag="$("$JQ_BIN" -rn --arg value "$RELEASE_TAG" '$value | @uri')" || {
    RELEASE_GATE_REASON="could not encode the GitHub release tag"
    return 1
  }
  if "$GH_BIN" api --hostname github.com \
    -H 'Accept: application/vnd.github+json' \
    -H "X-GitHub-Api-Version: $GITHUB_API_VERSION" \
    "repos/$RELEASE_OWNER/$RELEASE_REPO/releases/tags/$encoded_tag" \
    >"$output_file" 2>"$error_file"; then
    :
  else
    status=$?
    display_captured_diagnostics "$error_file" "GitHub Release lookup" || true
    RELEASE_GATE_REASON="GitHub Release lookup failed with status $status"
    return 1
  fi
  if ! "$JQ_BIN" -e \
    --arg tag "$RELEASE_TAG" \
    --arg prefix "https://github.com/$RELEASE_OWNER/$RELEASE_REPO/releases/tag/" '
      type == "object"
        and .tag_name == $tag
        and (.html_url | type == "string" and length > 0
          and (test("[[:cntrl:]]") | not)
          and (ascii_downcase | startswith($prefix | ascii_downcase)))
        and (.published_at | type == "string" and length > 0
          and (test("[[:cntrl:]]") | not))
        and (.draft | type) == "boolean"
        and (.prerelease | type) == "boolean"
        and (.assets | type) == "array"
    ' "$output_file" >/dev/null; then
    RELEASE_GATE_REASON="GitHub Release metadata is malformed or does not match the download tag"
    return 1
  fi
  RELEASE_NOTES_URL="$("$JQ_BIN" -r '.html_url' "$output_file")"
  RELEASE_RECORD_PUBLISHED_AT="$("$JQ_BIN" -r '.published_at' "$output_file")"
  RELEASE_DRAFT="$("$JQ_BIN" -r '.draft' "$output_file")"
  RELEASE_PRERELEASE="$("$JQ_BIN" -r '.prerelease' "$output_file")"

  if [[ "$RELEASE_SOURCE_KIND" != "release-asset" ]]; then
    RELEASE_GATE_REASON="GitHub tag archives are not bound to immutable release-asset metadata"
    return 1
  fi
  asset_values="$("$JQ_BIN" -er \
    --arg name "$RELEASE_ASSET_NAME" \
    --arg url "$CANDIDATE_URL" \
    --arg digest "sha256:${CANDIDATE_SHA256,,}" \
    --arg release "$RELEASE_RECORD_PUBLISHED_AT" '
      [.assets[] | select(.name == $name and .browser_download_url == $url)] as $matches
      | if ($matches | length) != 1 then
          error("release asset is missing or ambiguous")
        else
          $matches[0]
        end
      | select((.digest | type) == "string" and (.digest | ascii_downcase) == $digest)
      | [.created_at, .updated_at] as $asset_times
      | select(all($asset_times[]; type == "string" and length > 0))
      | ([ $release, $asset_times[] ]
          | map({text: ., epoch: (. | fromdateiso8601)})
          | max_by(.epoch).text) as $freshest
      | [$asset_times[0], $asset_times[1], $freshest] | @tsv
    ' "$output_file")" || {
      RELEASE_GATE_REASON="GitHub Release asset metadata is missing, ambiguous, or not bound to the Cask SHA-256"
      return 1
    }
  IFS=$'\t' read -r RELEASE_ASSET_CREATED_AT RELEASE_ASSET_UPDATED_AT \
    RELEASE_PUBLISHED_AT <<<"$asset_values"
  if [[ -z "$RELEASE_ASSET_CREATED_AT" || -z "$RELEASE_ASSET_UPDATED_AT" \
    || -z "$RELEASE_PUBLISHED_AT" ]]; then
    RELEASE_GATE_REASON="GitHub Release asset freshness metadata could not be evaluated"
    return 1
  fi
}

evaluate_release_age() {
  local published_at="$1"
  local now_epoch="$2"
  local values published_epoch

  RELEASE_AGE_VERIFIED=0
  RELEASE_ELIGIBLE_AT=""
  if [[ ! "$now_epoch" =~ ^[0-9]+$ ]]; then
    RELEASE_GATE_REASON="current time is unavailable"
    return 1
  fi
  values="$("$JQ_BIN" -nr \
    --arg published "$published_at" \
    --argjson cooldown "$COOLDOWN_SECONDS" '
      ($published | fromdateiso8601 | floor) as $published_epoch
        | [$published_epoch,
           ($published_epoch + $cooldown | strftime("%Y-%m-%dT%H:%M:%SZ"))]
        | @tsv
    ')" || {
    RELEASE_GATE_REASON="GitHub Release asset freshness timestamp is invalid"
    return 1
  }
  IFS=$'\t' read -r published_epoch RELEASE_ELIGIBLE_AT <<<"$values"
  if [[ ! "$published_epoch" =~ ^[0-9]+$ || -z "$RELEASE_ELIGIBLE_AT" ]]; then
    RELEASE_GATE_REASON="GitHub Release asset freshness timestamp could not be evaluated"
    return 1
  fi
  RELEASE_AGE_SECONDS=$((now_epoch - published_epoch))
  if (( RELEASE_AGE_SECONDS < 0 )); then
    RELEASE_GATE_REASON="GitHub Release asset freshness timestamp is in the future"
    return 1
  fi
  RELEASE_AGE_VERIFIED=1
}

format_duration() {
  local total_seconds="$1"
  local days hours minutes

  days=$((total_seconds / 86400))
  hours=$(((total_seconds % 86400) / 3600))
  minutes=$(((total_seconds % 3600) / 60))
  if (( days > 0 )); then
    printf '%dd %dh\n' "$days" "$hours"
  elif (( hours > 0 )); then
    printf '%dh %dm\n' "$hours" "$minutes"
  else
    printf '%dm\n' "$minutes"
  fi
}

review_printf() {
  if ! printf "$@"; then
    error "could not display the Cask review"
    return 1
  fi
}

print_cask_review() {
  local canonical="$1"
  local metadata_file="$2"
  local exception_set="$3"
  local exception_reason="$4"
  local artifacts_file="$TEMP_DIR/artifact-review"
  local age="" remaining="" artifact

  if ! "$JQ_BIN" -c '.casks[0].artifacts[]' "$metadata_file" >"$artifacts_file"; then
    error "could not encode the Cask artifact review"
    return 1
  fi
  if (( RELEASE_AGE_VERIFIED )); then
    age="$(format_duration "$RELEASE_AGE_SECONDS")" || return $?
  fi
  if [[ "$RELEASE_GATE_STATUS" == "blocked" ]] \
    && (( RELEASE_AGE_VERIFIED )) \
    && (( RELEASE_AGE_SECONDS < COOLDOWN_SECONDS )); then
    remaining="$(format_duration "$((COOLDOWN_SECONDS - RELEASE_AGE_SECONDS))")" || return $?
  fi

  review_printf '%s\n' '==> Cask review' || return $?
  review_printf 'Cask: %s\n' "$canonical" || return $?
  review_printf 'Version: %s -> %s\n' "$OUTDATED_INSTALLED" "$OUTDATED_CANDIDATE" || return $?
  review_printf 'SHA-256: %s\n' "$CANDIDATE_SHA256" || return $?
  review_printf 'Download: %s\n' "$CANDIDATE_URL" || return $?
  if [[ -n "$CANDIDATE_HOMEPAGE" ]]; then
    review_printf 'Homepage: %s\n' "$CANDIDATE_HOMEPAGE" || return $?
  fi
  review_printf '%s\n' 'Artifacts:' || return $?
  while IFS= read -r artifact; do
    review_printf '  - %s\n' "$artifact" || return $?
  done <"$artifacts_file" || {
    error "could not read the Cask artifact review"
    return 1
  }
  if [[ -n "$RELEASE_NOTES_URL" ]]; then
    review_printf 'Release notes: %s\n' "$RELEASE_NOTES_URL" || return $?
  else
    review_printf '%s\n' 'Release notes: unavailable' || return $?
  fi
  if (( RELEASE_AGE_VERIFIED )); then
    review_printf 'Artifact freshness: %s (%s ago)\n' "$RELEASE_PUBLISHED_AT" "$age" || return $?
    review_printf 'Eligible after: %s\n' "$RELEASE_ELIGIBLE_AT" || return $?
  elif [[ -n "$RELEASE_RECORD_PUBLISHED_AT" ]]; then
    review_printf 'Release published: %s (artifact freshness unverified)\n' \
      "$RELEASE_RECORD_PUBLISHED_AT" || return $?
  else
    review_printf '%s\n' 'Artifact freshness: unavailable' || return $?
  fi
  case "$RELEASE_GATE_STATUS" in
    eligible)
      if (( exception_set )); then
        review_printf '%s\n' 'Cooldown: eligible (exception not needed)' || return $?
      else
        review_printf '%s\n' 'Cooldown: eligible' || return $?
      fi
      ;;
    blocked)
      if [[ -n "$remaining" ]]; then
        review_printf 'Cooldown: blocked (%s remaining)\n' "$remaining" || return $?
      else
        review_printf '%s\n' 'Cooldown: blocked' || return $?
      fi
      review_printf 'Reason: %s\n' "$RELEASE_GATE_REASON" || return $?
      ;;
    unverified)
      review_printf '%s\n' 'Cooldown: unverified' || return $?
      review_printf 'Reason: %s\n' "$RELEASE_GATE_REASON" || return $?
      ;;
    exception)
      review_printf '%s\n' 'Cooldown: exception' || return $?
      review_printf 'Reason: %s\n' "$RELEASE_GATE_REASON" || return $?
      review_printf 'Exception reason: %s\n' "$exception_reason" || return $?
      ;;
  esac
}

review_release_cooldown() {
  local info_file="$1"
  local canonical="$2"
  local exception_set="$3"
  local exception_reason="$4"
  local now_epoch base_status

  RELEASE_NOTES_URL=""
  RELEASE_RECORD_PUBLISHED_AT=""
  RELEASE_PUBLISHED_AT=""
  RELEASE_ASSET_CREATED_AT=""
  RELEASE_ASSET_UPDATED_AT=""
  RELEASE_ELIGIBLE_AT=""
  RELEASE_AGE_SECONDS=0
  RELEASE_AGE_VERIFIED=0
  RELEASE_GATE_STATUS=""
  RELEASE_GATE_REASON=""
  RELEASE_DRAFT=""
  RELEASE_PRERELEASE=""

  if ! extract_github_release_coordinates "$info_file"; then
    RELEASE_GATE_STATUS="unverified"
  elif ! prepare_github_client; then
    RELEASE_GATE_STATUS="unverified"
  elif ! lookup_github_release; then
    RELEASE_GATE_STATUS="unverified"
  else
    now_epoch="$("$JQ_BIN" -nr 'now | floor')" || now_epoch=""
    if ! evaluate_release_age "$RELEASE_PUBLISHED_AT" "$now_epoch"; then
      RELEASE_GATE_STATUS="unverified"
    elif [[ "$RELEASE_DRAFT" == "true" ]]; then
      RELEASE_GATE_STATUS="blocked"
      RELEASE_GATE_REASON="GitHub Release is a draft"
    elif [[ "$RELEASE_PRERELEASE" == "true" ]]; then
      RELEASE_GATE_STATUS="blocked"
      RELEASE_GATE_REASON="GitHub Release is marked as a prerelease"
    elif (( RELEASE_AGE_SECONDS < COOLDOWN_SECONDS )); then
      RELEASE_GATE_STATUS="blocked"
      RELEASE_GATE_REASON="GitHub Release asset is newer than 7 days"
    else
      RELEASE_GATE_STATUS="eligible"
    fi
  fi

  base_status="$RELEASE_GATE_STATUS"
  if (( exception_set )) && [[ "$base_status" != "eligible" ]]; then
    RELEASE_GATE_STATUS="exception"
  fi
  print_cask_review "$canonical" "$info_file" \
    "$exception_set" "$exception_reason" || return $?
  if [[ "$base_status" != "eligible" ]] && (( ! exception_set )); then
    error "release cooldown requires manual review; rerun with --cooldown-exception REASON to continue"
    return 1
  fi
}

classify_outdated() {
  local canonical="$1"
  local output_file="$TEMP_DIR/outdated.json"
  local status=0

  if capture_command "$output_file" "$BREW_BIN" outdated --cask --json=v2 "$canonical"; then
    status=0
  else
    status=$?
  fi
  if ! "$JQ_BIN" -e \
    '(.formulae | type) == "array" and (.casks | type) == "array"' \
    "$output_file" >/dev/null; then
    error "brew outdated returned malformed JSON"
    return 1
  fi
  if (( status == 0 )) \
    && "$JQ_BIN" -e '(.formulae | length) == 0 and (.casks | length) == 0' \
      "$output_file" >/dev/null; then
    status_printf "the Cask status" '%s\n' \
      "Cask is already up to date: $canonical" || return $?
    return 10
  fi
  if (( status == 1 )) \
    && "$JQ_BIN" -e \
      --arg name "$canonical" \
      --arg installed "$INSTALLED_VERSION" \
      --arg current "$CANDIDATE_VERSION" '
        (.formulae | length) == 0
          and (.casks | length) == 1
          and .casks[0].name == $name
          and .casks[0].installed_versions == [$installed]
          and .casks[0].current_version == $current
          and .casks[0].pinned == false
      ' "$output_file" >/dev/null; then
    OUTDATED_INSTALLED="$INSTALLED_VERSION"
    OUTDATED_CANDIDATE="$CANDIDATE_VERSION"
    status_printf "the Cask status" 'Outdated Cask: %s %s -> %s\n' \
      "$canonical" "$OUTDATED_INSTALLED" "$OUTDATED_CANDIDATE" || return $?
    return 0
  fi
  error "brew outdated status and JSON disagree for: $canonical"
  return 1
}

show_dry_run() {
  local canonical="$1"
  local output_file="$TEMP_DIR/dry-run"

  if ! HOMEBREW_NO_INSTALL_CLEANUP=1 HOMEBREW_NO_ENV_HINTS=1 \
    capture_command "$output_file" "$BREW_BIN" upgrade --cask --dry-run \
      --require-sha --no-quit --skip-cask-deps "$canonical"; then
    error "brew upgrade --dry-run failed"
    return 1
  fi
  if [[ ! -s "$output_file" ]]; then
    error "brew upgrade --dry-run returned no reviewable output"
    return 1
  fi
  status_printf "the Cask dry-run heading" '%s\n' \
    '==> Complete Cask dry-run' || return $?
  if ! cat "$output_file"; then
    error "could not display the Cask dry-run"
    return 1
  fi
}

confirm_review() {
  local canonical="$1"
  local answer=""

  if ! printf '%s' \
    "Proceed with the displayed Cask metadata and dry-run for $canonical [y/N]: " \
    >&2; then
    error "could not display the Cask review confirmation prompt"
    return 1
  fi
  if ! IFS= read -r answer; then
    printf '\n' >&2
    error "confirmation input ended; brew update completed, but the Cask was not upgraded"
    return 1
  fi
  case "$answer" in
    [yY]|[yY][eE][sS]) return 0 ;;
    *)
      error "upgrade rejected; brew update completed, but the Cask was not upgraded"
      return 1
      ;;
  esac
}

run_stage() {
  local label="$1"
  shift

  status_printf "the $label stage" '%s\n' "==> $label" || return $?
  if run_managed "$@"; then
    return 0
  else
    local status=$?
    error "$label failed with status $status"
    return "$status"
  fi
}

verify_post_upgrade() {
  local canonical="$1"
  local reviewed_snapshot="$2"
  local output_file="$TEMP_DIR/info-final.json"
  local final_snapshot="$TEMP_DIR/candidate-final-snapshot.json"
  local final_installed

  load_named_metadata "$canonical" "$output_file" "post-upgrade" || return $?
  write_candidate_snapshot "$output_file" "$final_snapshot" || return $?
  if ! cmp -s "$reviewed_snapshot" "$final_snapshot"; then
    error "Cask safety metadata changed during upgrade; the Cask may already be modified"
    return 1
  fi
  final_installed="$(metadata_value "$output_file" '.casks[0].installed')" || return $?
  if [[ "$final_installed" != "$CANDIDATE_VERSION" ]]; then
    error "installed Cask version does not match the reviewed candidate; the Cask may already be modified"
    return 1
  fi
  printf 'Installed Cask version verified: %s %s\n' \
    "$canonical" "$final_installed"
}

main() {
  local cask=""
  local cooldown_exception_set=0
  local cooldown_exception_reason=""
  local resolved_smoke canonical post_update_canonical outdated_status=0
  local initial_file installed_state_file installed_state_snapshot installed_receipt_snapshot
  local candidate_file candidate_snapshot pre_upgrade_state pre_upgrade_state_snapshot
  local pre_upgrade_receipt_snapshot pre_upgrade_candidate pre_upgrade_candidate_snapshot
  local -a smoke_command=()

  case "${1:-}" in
    -h|--help)
      usage
      return 0
      ;;
  esac
  if [[ "${1:-}" == "--cooldown-exception" ]]; then
    cooldown_exception_set=1
    if (( $# < 2 )); then
      usage >&2
      return 2
    fi
    cooldown_exception_reason="$2"
    shift 2
  fi
  if [[ -z "${1:-}" ]]; then
    usage >&2
    return 2
  fi
  cask="$1"
  shift
  if [[ "${1:-}" != "--" ]] || (( $# < 2 )); then
    usage >&2
    return 2
  fi
  shift
  smoke_command=("$@")

  if (( cooldown_exception_set )) \
    && { [[ "$cooldown_exception_reason" =~ ^[[:space:]]*$ ]] \
      || [[ "$cooldown_exception_reason" =~ [[:cntrl:]] ]]; }; then
    error "cooldown exception reason must be non-empty and single-line"
    return 2
  fi
  if [[ -z "$cask" || "$cask" == -* || "$cask" == *[[:space:]]* ]] \
    || [[ "$cask" =~ [[:cntrl:]] ]]; then
    error "invalid Cask name"
    return 2
  fi

  resolved_smoke="$(resolve_command "${smoke_command[0]}")" || return $?
  smoke_command[0]="$resolved_smoke"
  BREW_BIN="$(resolve_command brew)" || return $?
  JQ_BIN="$(resolve_command jq)" || return $?
  TEMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/brew-reviewed-cask-upgrade.XXXXXX")" || {
    error "could not create temporary directory"
    return 1
  }
  install_lifecycle_traps

  validate_policy_file || return $?
  validate_effective_policy || return $?
  validate_developer_mode || return $?

  initial_file="$TEMP_DIR/info-initial.json"
  load_named_metadata "$cask" "$initial_file" "initial" || return $?
  canonical="$(metadata_value "$initial_file" '.casks[0].token')" || return $?

  installed_state_file="$TEMP_DIR/info-installed-state.json"
  load_installed_state "$canonical" "$installed_state_file" || return $?
  INSTALLED_VERSION="$(metadata_value "$installed_state_file" '.casks[0].installed')" || return $?
  installed_state_snapshot="$TEMP_DIR/installed-state-snapshot.json"
  write_installed_state_snapshot "$installed_state_file" "$installed_state_snapshot" || return $?
  installed_receipt_snapshot="$TEMP_DIR/installed-receipt-snapshot.json"
  load_installed_receipt_snapshot "$canonical" "$INSTALLED_VERSION" \
    "$installed_receipt_snapshot" || return $?

  status_printf "the Homebrew update stage" '%s\n' \
    '==> Updating Homebrew metadata' || return $?
  if ! "$BREW_BIN" update; then
    error "brew update failed"
    return 1
  fi

  candidate_file="$TEMP_DIR/info-candidate.json"
  load_named_metadata "$canonical" "$candidate_file" "candidate" || return $?
  post_update_canonical="$(metadata_value "$candidate_file" '.casks[0].token')" || return $?
  if [[ "$post_update_canonical" != "$canonical" ]]; then
    error "Cask identity changed after brew update: $canonical -> $post_update_canonical"
    return 1
  fi
  CANDIDATE_VERSION="$(metadata_value "$candidate_file" '.casks[0].version')" || return $?
  CANDIDATE_SHA256="$(metadata_value "$candidate_file" '.casks[0].sha256')" || return $?
  CANDIDATE_URL="$(metadata_value "$candidate_file" '.casks[0].url')" || return $?
  CANDIDATE_HOMEPAGE="$("$JQ_BIN" -r '.casks[0].homepage // ""' "$candidate_file")" || return $?
  candidate_snapshot="$TEMP_DIR/candidate-reviewed-snapshot.json"
  write_candidate_snapshot "$candidate_file" "$candidate_snapshot" || return $?

  if classify_outdated "$canonical"; then
    outdated_status=0
  else
    outdated_status=$?
  fi
  if (( outdated_status == 10 )); then
    return 0
  fi
  if (( outdated_status != 0 )); then
    return "$outdated_status"
  fi

  review_release_cooldown "$candidate_file" "$canonical" \
    "$cooldown_exception_set" "$cooldown_exception_reason" || return $?
  show_dry_run "$canonical" || return $?
  confirm_review "$canonical" || return $?

  pre_upgrade_state="$TEMP_DIR/info-installed-state-pre-upgrade.json"
  pre_upgrade_state_snapshot="$TEMP_DIR/installed-state-pre-upgrade-snapshot.json"
  load_installed_state "$canonical" "$pre_upgrade_state" || return $?
  write_installed_state_snapshot "$pre_upgrade_state" \
    "$pre_upgrade_state_snapshot" || return $?
  if ! cmp -s "$installed_state_snapshot" "$pre_upgrade_state_snapshot"; then
    error "installed Cask state changed before upgrade"
    return 1
  fi
  pre_upgrade_receipt_snapshot="$TEMP_DIR/installed-receipt-pre-upgrade-snapshot.json"
  load_installed_receipt_snapshot "$canonical" "$INSTALLED_VERSION" \
    "$pre_upgrade_receipt_snapshot" || return $?
  if ! cmp -s "$installed_receipt_snapshot" "$pre_upgrade_receipt_snapshot"; then
    error "installed Cask receipt changed before upgrade"
    return 1
  fi
  pre_upgrade_candidate="$TEMP_DIR/info-candidate-pre-upgrade.json"
  pre_upgrade_candidate_snapshot="$TEMP_DIR/candidate-pre-upgrade-snapshot.json"
  load_named_metadata "$canonical" "$pre_upgrade_candidate" "pre-upgrade candidate" || return $?
  write_candidate_snapshot "$pre_upgrade_candidate" \
    "$pre_upgrade_candidate_snapshot" || return $?
  if ! cmp -s "$candidate_snapshot" "$pre_upgrade_candidate_snapshot"; then
    error "reviewed candidate Cask safety metadata changed before upgrade"
    return 1
  fi

  HOMEBREW_NO_INSTALL_CLEANUP=1 HOMEBREW_NO_ENV_HINTS=1 \
    run_stage "Upgrading $canonical" "$BREW_BIN" upgrade --cask --no-ask \
      --require-sha --no-quit --skip-cask-deps "$canonical" || return $?
  verify_post_upgrade "$canonical" "$candidate_snapshot" || return $?
  run_stage "Running smoke command" "${smoke_command[@]}" || return $?
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
